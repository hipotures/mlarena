# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Large data artifacts (keep code + docs only)
*.csv
*.tsv
*.zip
*.gz
*.bz2
*.xz
*.7z
*.parquet
*.feather
*.arrow
*.npy
*.npz
*.pkl
*.pickle
*.joblib
*.h5
*.pt
*.pth
*.onnx
*.ckpt
*.weights
*.db
*.sqlite
*.sqlite3
*.tfevents
*.tgz
*.tar
*.tar.gz
*.ipynb

# Model outputs / caches
**/AutogluonModels/
**/wandb/
**/mlruns/
**/preprocess_cache/

# Misc binaries & temporary artifacts
*.log
*.journal
*.tmp
*.bak
*.swp
*.swo
*.DS_Store
*.lock
*.old

# Experiments - ignore all contents except init/, eda/, and state.json
**/experiments/**
!**/experiments/
!**/experiments/.gitkeep
!**/experiments/init/
!**/experiments/init/**
!**/experiments/eda/
!**/experiments/eda/**
!**/experiments/*/
!**/experiments/*/state.json

# But skip large EDA files in init/
**/experiments/init/eda/*.html
**/experiments/init/eda/ydata_profile.json
**/experiments/init/eda/ydata_profile_test.json

# Migration/backup directories
**/.old/

# Legacy projects with non-standard architecture (pre-MLArena migration)
# These projects contain code incompatible with current project structure
projects/kaggle/playground-series-s4e10/
projects/kaggle/playground-series-s4e11/
projects/kaggle/playground-series-s4e2/
projects/kaggle/playground-series-s4e4/
projects/kaggle/playground-series-s4e5/
